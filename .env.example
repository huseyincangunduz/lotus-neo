NEOLIT_PATH=/path/to/neolit
LOTUS_NEO_PATH=/path/to/lotus-neo
WEB_DEPLOY_PATH=/path/to/web-root

# Android toolchain
GRADLE_JDK=/path/to/jdk
ANDROID_HOME=/path/to/android-sdk

# Play Store release signing (use an absolute keystore path)
ANDROID_KEYSTORE_PATH=/path/to/upload-key.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=
